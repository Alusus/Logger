import "Srl/String";
import "Srl/StringBuilder";
import "Srl/Console";
import "Srl/Time";
import "Srl/errors";
import "Srl/Map";
import "Core/Ast";
import "Spp";
import "Apm";
Apm.importPackage("Alusus/Sle@0.2", { "Srl/Time" });

class Logger {
    use Srl;

    def Level: {
        def ERROR: 40;
        def WARNING: 30;
        def INFO: 20;
        def DEBUG: 10;
    }

    def globalBuf: StringBuilder;
    def buf: StringBuilder;

    // UTC (+00:00) is the default. Pass true to print local time with its offset instead.
    def useLocalTime: Bool = false;

    // Entries below this level are not printed. Unknown values are ignored.
    def _logLevel: Int = Level.INFO;
    handler this.logLevel = Int {
        if value == Level.DEBUG or value == Level.INFO or value == Level.WARNING or value == Level.ERROR {
            this._logLevel = value;
        }
        return this._logLevel;
    }
    handler this.logLevel: Int return this._logLevel;

    func levelName(level: Int): CharsPtr {
        if level == Level.ERROR return "error";
        if level == Level.WARNING return "warning";
        if level == Level.INFO return "info";
        return "debug";
    }

    // Global Data Functions
    //======================

    handler this.set(key: CharsPtr, val: CharsPtr) {
        _appendKey(this.globalBuf, key);
        if _needsQuotes(val) {
            this.globalBuf += '"';
            _appendEscaped(this.globalBuf, val);
            this.globalBuf += '"';
        } else this.globalBuf += val;
    }

    handler this.set(key: CharsPtr, val: Int[64]) {
        _appendKey(this.globalBuf, key);
        this.globalBuf += val;
    }

    handler this.set(key: CharsPtr, val: Float[64]) {
        _appendKey(this.globalBuf, key);
        this.globalBuf += val;
    }

    handler this.set(key: CharsPtr, val: Bool) {
        _appendKey(this.globalBuf, key);
        if val this.globalBuf += "true" else this.globalBuf += "false";
    }

    @member macro set[this, props] this.{
        preprocess { Logger._insertProps(ast props) }
    }

    handler this.clear() {
        this.globalBuf.clear();
    }

    // Buffer Functions
    //=================

    // A value needs quotes if it is empty or has a char that would break the key=value format.
    func _needsQuotes(str: CharsPtr): Bool {
        if str~cnt(0) == 0 return true;
        def i: ArchInt = 0;
        while str~cnt(i) != 0 {
            def c: Char = str~cnt(i);
            if c == ' ' or c == '=' or c == '"' or c == '\\' or c < ' ' or c~cast[Int] == 127 return true;
            ++i;
        }
        return false;
    }

    func _appendKey(buf: ref[StringBuilder], key: CharsPtr) {
        _appendKey(buf, key, 0);
    }

    func _appendKey(buf: ref[StringBuilder], key: CharsPtr, subKey: CharsPtr) {
        buf += ' ';
        if key~cnt(0) == 0 {
            buf += '_';
        } else {
            def i: ArchInt = 0;
            while key~cnt(i) != 0 {
                def c: Char = key~cnt(i);
                if c == ' ' or c == '=' or c == '"' or c < ' ' or c~cast[Int] == 127 {
                    buf += '_';
                } else buf += c;
                ++i;
            }
        }
        if subKey != 0 buf += subKey;
        buf += '=';
    }

    func _appendEscaped(buf: ref[StringBuilder], str: CharsPtr) {
        def i: ArchInt = 0;
        while str~cnt(i) != 0 {
            def c: Char = str~cnt(i);
            if c == '"' buf += "\\\""
            else if c == '\\' buf += "\\\\"
            else if c == '\n' buf += "\\n"
            else if c == '\r' buf += "\\r"
            else if c == '\t' buf += "\\t"
            else if c < ' ' {
                def esc: array[Char, 8];
                String.assign(esc(0)~ptr, "\\u%04x", c~cast[Int]);
                buf += esc(0)~ptr~cast[CharsPtr];
            } else buf += c;
            ++i;
        }
    }

    // Entry helper class
    //===================

    class Entry {
        def logger: ref[Logger];
        def level: Int;

        handler this~init(logger: ref[Logger], level: Int, msg: CharsPtr) {
            this.logger~no_deref = logger;
            this.level = level;
            def time: String;
            if this.level < this.logger.logLevel return;

            this.logger.buf.clear();
            if this.logger.useLocalTime time = Time.getCurrentStringLocalDateTime()
            else time = Time.getCurrentStringUTCDateTime();
            this.logger.buf.format("time=%s level=%s", time.buf, levelName(level));
            this.set("message", msg)
            this.logger.buf += this.logger.globalBuf;
        }

        handler this.set(key: CharsPtr, val: CharsPtr) this.set(key, val, 0);

        handler this.set(key: CharsPtr, val: CharsPtr, subKey: CharsPtr) {
            if this.level < this.logger.logLevel return;

            _appendKey(this.logger.buf, key, subKey);
            if _needsQuotes(val) {
                this.logger.buf += '"';
                _appendEscaped(this.logger.buf, val);
                this.logger.buf += '"';
            } else this.logger.buf += val;
        }

        handler this.set(key: CharsPtr, val: Int[64]) {
            if this.level < this.logger.logLevel return;

            _appendKey(this.logger.buf, key);
            this.logger.buf += val;
        }

        handler this.set(key: CharsPtr, val: Float[64]) {
            if this.level < this.logger.logLevel return;

            _appendKey(this.logger.buf, key);
            this.logger.buf += val;
        }

        handler this.set(key: CharsPtr, val: Bool) {
            if this.level < this.logger.logLevel return;

            _appendKey(this.logger.buf, key);
            if val this.logger.buf += "true" else this.logger.buf += "false";
        }

        handler this.set(key: CharsPtr, val: ref[Error]) {
            if this.level < this.logger.logLevel return;

            this.set("error", val.getCode(), ".code");
            this.set("error", val.getMessage(), ".msg");
        }

        handler this.send() {
            if this.level < this.logger.logLevel return;
            Console.print("%s\n", this.logger.buf.string.buf);
        }
    }

    // Member macros
    //==============

    @member macro error [this, msg] Logger.Entry(this, Logger.Level.ERROR, msg).{
        send();
    }
    @member macro error [this, msg, props] Logger.Entry(this, Logger.Level.ERROR, msg).{
        preprocess { Logger._insertProps(ast props) }
        send();
    }

    @member macro warning [this, msg] Logger.Entry(this, Logger.Level.WARNING, msg).{
        send();
    }
    @member macro warning [this, msg, props] Logger.Entry(this, Logger.Level.WARNING, msg).{
        preprocess { Logger._insertProps(ast props) }
        send();
    }

    @member macro info [this, msg] Logger.Entry(this, Logger.Level.INFO, msg).{
        send();
    }
    @member macro info [this, msg, props] Logger.Entry(this, Logger.Level.INFO, msg).{
        preprocess { Logger._insertProps(ast props) }
        send();
    }

    @member macro debug [this, msg] Logger.Entry(this, Logger.Level.DEBUG, msg).{
        send();
    }
    @member macro debug [this, msg, props] Logger.Entry(this, Logger.Level.DEBUG, msg).{
        preprocess { Logger._insertProps(ast props) }
        send();
    }

    func _insertProps (props: ref[Core.Ast.Node]) {
        use Core.Basic;
        use Core.Ast;

        if props~ptr == 0 return;
        if isDerivedFrom[props, List] or isDerivedFrom[props, Bracket] {
            def container: ContainerOf[props, Node];
            def i: Word;
            for i = 0, i < container.getElementCount(), ++i {
                _insertProps(container.getElement(i));
            }
        } else if isDerivedFrom[props, LinkOperator] {
            def linkContainer: ContainerOf[props, Node];
            def key: StringLiteral;
            def keyElement: ref[Node](linkContainer.getElement(0));
            if isDerivedFrom[keyElement, StringLiteral] {
                key.value.value = castRef[keyElement, StringLiteral].value.value
            } else if isDerivedFrom[keyElement, Identifier] {
                key.value.value = castRef[keyElement, StringLiteral].value.value
            } else {
                Spp.buildMgr.raiseBuildNotice("CP1001", 1, keyElement);
                return;
            }
            Spp.astMgr.insertAst(
                (ast set(key, val)),
                Srl.Map[String, ref[Node]]()
                    .set(String("key"), key)
                    .set(String("val"), linkContainer.getElement(1))
            );
        } else {
            Spp.buildMgr.raiseBuildNotice("CP1001", 1, props);
        }
    }
}
