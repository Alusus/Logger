اشمل "مـتم/أخطاء"؛
اشمل "مـتم/سندات"؛
اشمل "مـحا"؛
مـحا.اشمل_حزمة("Alusus/Logger@0.1"، "مـسجل")؛

استخدم مـتم؛

دالة اختبر {
    عرف سجل: مـسجل؛

    // المستوى الافتراضي هو معلومات، لذا تُهمل سجلات التنقيح.
    سجل.تنقيح["لن تُطبع"]؛

    // المستويات: تنقيح، معلومات، تحذير، خطأ.
    سجل.مستوى_التسجيل = مـسجل.مـستوى.تـنقيح؛
    سجل.تنقيح["رسالة تنقيح"]؛
    سجل.معلومات["رسالة معلومات"]؛
    سجل.تحذير["رسالة تحذير"]؛
    سجل.خطأ["رسالة خطأ"]؛

    // تصفية المستويات. تُهمل السجلات الأدنى من المستوى المحدد وتُتجاهل القيم غير المعروفة.
    سجل.مستوى_التسجيل = مـسجل.مـستوى.تـحذير؛
    سجل.معلومات["لن تُطبع"]؛
    سجل.تحذير["ستُطبع"]؛
    سجل.مستوى_التسجيل = 123؛
    سجل.معلومات["لن تُطبع (القيمة 123 مُتجاهلة والمستوى ما زال تحذير)"]؛
    سجل.مستوى_التسجيل = مـسجل.مـستوى.تـنقيح؛

    // خصائص من كل الأنواع المدعومة. يمكن أن تكون المفاتيح معرّفات أو سلاسل نصية.
    سجل.معلومات["أنواع القيم"، {
        نص: "مرحبا"،
        عدد: 42،
        نسبة: 3.14،
        تفعيل: 1،
        تعطيل: 0،
        "مفتاح باقتباس": "المفاتيح ذات المحارف غير الصالحة يجري تعديلها"
    }]؛

    // قيم تحتاج إلى علامات اقتباس أو تهريب.
    سجل.معلومات["علامات الاقتباس والتهريب"، {
        مع_مسافة: "كلمتان اثنتان"،
        مع_مساواة: "أ=ب"،
        مع_اقتباس: "قل \"مرحبا\""،
        مع_شارحة_مائلة: "C:\\temp"،
        مع_سطر_جديد: "سطر1\جسطر2"،
        مع_إزاحة: "أ\تب"،
        فارغة: ""
    }]؛

    // رسالة تحتوي على محارف تحتاج إلى تهريب.
    سجل.معلومات["رسالة من عدة كلمات \"بين اقتباس\"\جوفيها سطر جديد"]؛

    // الخصائص العامة تُضاف إلى كل سجل لاحق.
    سجل.حدد["خدمة": "فوترة"]؛
    سجل.حدد[{"منفذ": 8080}]؛
    سجل.حدد[(نسبة: 0.5)]؛
    سجل.حدد["نمط_التنقيح": 1]؛
    سجل.حدد[{ المنطقة: "eu"، النسخة: 3 }]؛
    سجل.معلومات["مع خصائص عامة"]؛
    سجل.خطأ["الخصائص العامة تُدمج مع خصائص السجل"، رقم_الطلب: 17]؛

    // يمكن إرفاق خطأ بالسجل، وعندها يُضاف error.code وerror.msg.
    عرف الخطأ: سـندنا[خـطأ_عام] = خـطأ_عام.أنشئ("E100"، "حدث خطأ ما")؛
    سجل.خطأ["فشل مع كائن خطأ"، (خطأ: الخطأ، إضافي: "قيمة")]؛

    // سجلات يدوية بدون ماكرو.
    عرف يدوي: مـسجل.مـدخل(سجل، مـسجل.مـستوى.مـعلومات، "سجل يدوي")؛
    يدوي.حدد("ن"، 1)؛
    يدوي.أرسل()؛

    // الوقت المحلي (مع الإزاحة) بدل التوقيت العالمي.
    سجل.استخدم_الوقت_المحلي = 1؛
    سجل.معلومات["الوقت المحلي"]؛
    سجل.استخدم_الوقت_المحلي = 0؛

    // لكل مسجل إعداداته المستقلة.
    عرف هادئ: مـسجل؛
    هادئ.معلومات["مسجل مستقل بمستواه الافتراضي وبدون خصائص عامة"]؛
    هادئ.تنقيح["لن تُطبع"]؛
}

اختبر()؛

دالة اختبر_الأخطاء {
    عرف سجل: مـسجل؛
    سجل.معلومات["اختبار خطأ المترجم"، { a: b }]؛
    سجل.معلومات["اختبار خطأ المترجم"، { 1: b }]؛
}

اختبر_الأخطاء()؛
