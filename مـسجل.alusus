اشمل "Logger.alusus"؛

عرف مـسجل: لقب Logger؛
@دمج وحدة مـسجل {
    عرف مـستوى: لقب Level؛
    @دمج وحدة مـستوى {
        عرف خـطأ: لقب ERROR؛
        عرف تـحذير: لقب WARNING؛
        عرف مـعلومات: لقب INFO؛
        عرف تـنقيح: لقب DEBUG؛
    }

    عرف استخدم_الوقت_المحلي: لقب useLocalTime؛
    عرف حدد_المستوى: لقب setLevel؛

    عرف مـدخل: لقب Entry؛
    @دمج صنف مـدخل {
        عرف نص: لقب str؛
        عرف رقم: لقب num؛
        عرف ثنائي: لقب bool؛
        عرف رسالة: لقب msg؛
        عرف أرسل: لقب send؛
    }

    عرف خطأ: لقب error؛
    عرف تحذير: لقب warning؛
    عرف معلومات: لقب info؛
    عرف تنقيح: لقب debug؛
}
